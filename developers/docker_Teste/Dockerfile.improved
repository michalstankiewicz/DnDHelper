# Multi-stage Dockerfile for D&D Helper
# Stage 1: Builder
FROM python:3.11-slim as builder

WORKDIR /build

COPY req.txt .

RUN pip install --user --no-cache-dir -r req.txt


# Stage 2: Runtime
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

# Install tkinter if GUI requires it (uncomment if needed)
# RUN apt-get update && apt-get install -y python3-tk && rm -rf /var/lib/apt/lists/*

# Copy only required dependencies from builder
COPY --from=builder /root/.local /root/.local

ENV PATH=/root/.local/bin:$PATH

COPY . .

# Create logs directory for logging
RUN mkdir -p /app/logs

# Health check for test mode
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD test -f /app/log.txt || exit 1

# Default: start GUI (use --test flag via docker run for test mode)
CMD ["python", "main.py"]
